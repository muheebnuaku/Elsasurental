# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_* values are sent to the browser — never put secrets in them.

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Step 2/3) ──────────────────────────────────────────────
# Local values are printed by `pnpm db:start`. Production: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — used for webhooks and cron only.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth "Send SMS" hook secret ("v1,whsec_..."), from Supabase → Authentication → Hooks.
# Hook URL: https://<your-domain>/api/auth/sms-hook
SUPABASE_SMS_HOOK_SECRET=

# ── Quote signing (Step 4) ───────────────────────────────────────────
# Random 32+ byte secret, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
QUOTE_SIGNING_SECRET=
# Secret for public tracking links (/track/[ref]?t=...) — Phase 2
TRACKING_LINK_SECRET=

# ── Google Maps (Step 4/7) ───────────────────────────────────────────
# Browser key: restrict to your domains + Maps JS & Places APIs
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key: restrict to Distance Matrix / Routes API
GOOGLE_MAPS_SERVER_KEY=

# ── Paystack (Step 8) — use test keys in development ─────────────────
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ── Notifications (Step 9) ───────────────────────────────────────────
# WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Language code the WhatsApp templates were approved in
WHATSAPP_TEMPLATE_LANG=en
# Phase 2 (bot webhook)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# SMS: "arkesel" or "hubtel"
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
SMS_SENDER_ID=Elsasu
# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Elsasu Rentals <bookings@elsasu.com>"
# Where admin alerts go
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=

# ── Cron (Step 9) ────────────────────────────────────────────────────
# Sent as "Authorization: Bearer <CRON_SECRET>" by the GitHub Actions schedule. Also add it as a GitHub repo secret.
CRON_SECRET=

# ── AI assistant + booking-form AI ───────────────────────────────────
# Get a key at platform.openai.com/api-keys. Without it the site works; the AI features show "offline".
OPENAI_API_KEY=
# Any OpenAI model id. Default gpt-5.4-mini (fast, low cost).
AI_MODEL=gpt-5.4-mini

# ── Observability (Step 12) — both off until set ─────────────────────
# Sentry → Project Settings → Client Keys (DSN). Auth token only needed to upload source maps at build time.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# PostHog → Project Settings → Project API key. Host: eu.i.posthog.com or us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
